{
  "name": "@adeptify/goalboard-exchange",
  "version": "0.0.0",
  "private": true,
  "description": "Envelope routing, ordering, CAS, ACK, Cursor, Replay, Blob, and retention boundary.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@adeptify/goalboard-contracts": "workspace:*"
  },
  "goalboard": {
    "path": "packages/exchange",
    "kind": "foundation",
    "maturity": "contract-only",
    "contract": "@adeptify/goalboard-contracts/platform/exchange",
    "migrationGoals": [
      "goal-reorg-f2"
    ],
    "ssot": "docs/SSOT-MATRIX.md"
  }
}
