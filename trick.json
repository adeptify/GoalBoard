{
  "name": "goalboard",
  "title": "GoalBoard 本地目标真相源",
  "description": "人和 Agent Runtime 共用的 SQLite Goal 真相源，提供 V1 CLI、MCP、Web 与 Runtime Skill；Runtime 自主领取，不由 GoalBoard 分发。",
  "type": "skills",
  "version": "0.1.0",
  "platforms": ["darwin", "linux"],
  "targets": ["codex", "claude-code", "devin"],
  "requires": ["node", "pnpm"],
  "install": {
    "note": "先 build CLI/MCP，再安装 Skill 到 Codex；如使用 Claude Code，会尝试安装到 ~/.claude/skills（目录不存在则跳过）。",
    "steps": [
      { "type": "run", "cmd": "pnpm", "args": ["install"] },
      { "type": "run", "cmd": "pnpm", "args": ["build"] },
      {
        "type": "message",
        "text": "可选：pnpm link --global 暴露 goalboard；MCP 指向 dist/mcp/server.js"
      },
      { "type": "message", "text": "安装到 Codex（~/.codex/skills）" },
      {
        "type": "link",
        "source": "skills/goal-advance",
        "target": "~/.codex/skills/goal-advance"
      },
      { "type": "message", "text": "可选：安装到 Claude Code（~/.claude/skills）" },
      {
        "type": "link",
        "source": "skills/goal-advance",
        "target": "~/.claude/skills/goal-advance",
        "optional": true
      }
    ]
  },
  "status": {
    "checks": [
      {
        "type": "any_exists",
        "paths": [
          "~/.codex/skills/goal-advance",
          "~/.claude/skills/goal-advance"
        ]
      },
      {
        "type": "exists",
        "paths": ["dist/cli/main.js"]
      }
    ]
  },
  "usage": [
    "goalboard v1 init --db .goalboard/board.db --json '{...}'",
    "goalboard-web --db .goalboard/board.db --board-id my-board",
    "$goal-advance 读取并领取当前 Ready Goal",
    "goalboard v1 import-v3 --db .goalboard/imported.db --board-id imported --file legacy.json"
  ]
}
