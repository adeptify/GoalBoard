{
  "name": "@adeptify/goalboard-module-identity-team-access",
  "version": "0.0.0",
  "private": true,
  "description": "User, Team, membership, grant, and Access Decision facts.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@adeptify/goalboard-contracts": "workspace:*"
  },
  "goalboard": {
    "path": "modules/identity-team-access",
    "kind": "module",
    "maturity": "contract-only",
    "contract": "@adeptify/goalboard-contracts/modules/identity-team-access",
    "migrationGoals": [
      "goal-reorg-f2"
    ],
    "ssot": "docs/SSOT-MATRIX.md"
  }
}
