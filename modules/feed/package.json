{
  "name": "@adeptify/goalboard-module-feed",
  "version": "0.0.0",
  "private": true,
  "description": "Feed Item visibility, read/archive state, disposition, and promotion provenance.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@adeptify/goalboard-contracts": "workspace:*"
  },
  "goalboard": {
    "path": "modules/feed",
    "kind": "module",
    "maturity": "partial",
    "contract": "@adeptify/goalboard-contracts/modules/feed",
    "migrationGoals": [
      "goal-reorg-f2",
      "goal-reorg-fd2"
    ],
    "ssot": "docs/SSOT-MATRIX.md",
    "capabilities": [
      "feed.query.v1",
      "feed.command.v1"
    ]
  }
}
