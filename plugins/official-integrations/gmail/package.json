{
  "name": "@adeptify/goalboard-integration-gmail",
  "version": "0.0.0",
  "private": true,
  "description": "Official Gmail OAuth, connector, listener, Signal, settings, and Action adapters.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./history-cursor": {
      "types": "./dist/history-cursor.d.ts",
      "import": "./dist/history-cursor.js"
    },
    "./scope": {
      "types": "./dist/scope.d.ts",
      "import": "./dist/scope.js"
    }
  },
  "files": [
    "dist",
    "manifest.json",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@adeptify/goalboard-contracts": "workspace:*",
    "@adeptify/goalboard-plugin-sdk": "workspace:*"
  },
  "goalboard": {
    "path": "plugins/official-integrations/gmail",
    "kind": "integration-plugin",
    "maturity": "partial",
    "contract": "@adeptify/goalboard-contracts/platform/plugin",
    "migrationGoals": [
      "goal-reorg-f2",
      "goal-reorg-fd3"
    ],
    "ssot": "docs/SSOT-MATRIX.md"
  }
}
