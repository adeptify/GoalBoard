{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoalBoard",
  "version": "0.1.12",
  "identifier": "com.adeptify.goalboard",
  "build": {
    "frontendDist": "../webview-placeholder"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "GoalBoard",
        "width": 1180,
        "height": 760,
        "minWidth": 460,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 24
        },
        "url": "index.html"
      },
      {
        "label": "capsule",
        "title": "GoalBoard 工作胶囊",
        "width": 420,
        "height": 476,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "transparent": true,
        "shadow": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": ["resources/goalboard-runtime"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
