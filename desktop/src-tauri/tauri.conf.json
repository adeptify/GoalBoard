{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoalBoard",
  "version": "0.1.0",
  "identifier": "com.adeptify.goalboard",
  "build": {
    "frontendDist": "../webview-placeholder"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GoalBoard",
        "width": 1440,
        "height": 900,
        "url": "http://127.0.0.1:4173/?desktop=1"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": ["app"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
